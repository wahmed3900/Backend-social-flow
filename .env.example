NODE_ENV=development
PORT=5000

# Where the frontend lives. When the backend serves public/ (default), this is
# the backend's own URL. OAuth callbacks redirect back here.
CLIENT_URL=http://localhost:5000

MONGODB_URI=mongodb://localhost:27017/socialflow
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional — fallback captions are used without it
OPENAI_API_KEY=

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/platforms/meta/callback

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:5000/api/platforms/twitter/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/platforms/linkedin/callback
